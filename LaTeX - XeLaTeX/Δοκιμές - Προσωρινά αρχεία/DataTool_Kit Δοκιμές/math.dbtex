\db@col@elt@w Να λυθούν τα παρακάτω συστήματα ένα με τη μέθοδο της αντικατάστασης και ένα με τη μέθοδο των οριζουσών.
\begin{multicols}{2}
\begin{enumerate}[label=\roman*.,itemsep=0mm]
\item $\ccases{
x+2y=3\\
4x-3y=1}$
\item $\ccases{
3x+2y=5\\
-x+y=-5}$
\end{enumerate}\end{multicols}%
