\keys_define:nn {matrixStyle}
{
	style .tl_set:N = \l__matrixstyle_tl,
  	style .initial:n = { pmatrix },
	style .choices:nn = { pmatrix,bmatrix,vmatrix,Bmatrix,Vmatrix,matrix } { \tl_set:Nn \l__matrixstyle_tl {#1} },
}

\cs_new_protected:Nn \csm_matrix_print:n
 {
  \seq_clear:N \l__csm_matrix_rows_seq
  \int_set:Nn \l__csm_matrix_columns_int { \prop_item:cn { g_csm_matrix_#1_prop } {columns} }
  \int_step_inline:nn { \prop_item:cn { g_csm_matrix_#1_prop } {rows} }
   {
    \seq_clear:N \l__csm_matrix_row_seq
    \int_step_inline:nn { \l__csm_matrix_columns_int }
     {
      \seq_put_right:Ne \l__csm_matrix_row_seq
       {
        \fparray_item_to_tl:cn { g_csm_matrix_#1_fparray }
         { (##1-1)*\l__csm_matrix_columns_int + ####1 }
       }
     }
    \seq_put_right:Ne \l__csm_matrix_rows_seq { \seq_use:Nn \l__csm_matrix_row_seq { & } }
   }
  \begin{\l__matrixstyle_tl}
  \seq_use:Nn \l__csm_matrix_rows_seq { \\ }
  \end{\l__matrixstyle_tl}
 }

\NewDocumentCommand{\printmatrix}{O{}m}
 {% #1 = matrix name
	\keys_set:nn { matrixStyle } {#1}
  	\csm_matrix_print:n {#2}
 }
