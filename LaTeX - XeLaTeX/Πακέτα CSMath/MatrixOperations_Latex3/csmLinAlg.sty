%=========================================================================
%	Square Matrix check
%=========================================================================
\cs_new:Nn \isSquare:n
{
	\int_set:Nn \l_A_rows { \prop_item:cn { g_csm_matrix_#1_prop } {rows} } % m γραμμές
  	\int_set:Nn \l_A_columns { \prop_item:cn { g_csm_matrix_#1_prop } {columns} } % n στηλες

	\if_int_compare:w \l_A_rows = \l_A_columns
	Square
	 \else: not~square
	\fi:
}

\NewDocumentCommand{\csmIsMatrixSquare}{m}
{
	\isSquare:n {#1}
}
