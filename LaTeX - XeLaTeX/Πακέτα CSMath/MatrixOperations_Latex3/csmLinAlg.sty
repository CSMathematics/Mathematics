%=========================================================================
%	Identity Matrix
%=========================================================================
\cs_new_protected:Nn \matrixIdentity:nn
{
    % #1 = Όνομα πίνακα, #2 = Διάσταση (n)
%    \int_new:N \l__n_int
    \int_set:Nn \l_tmpa_int { #2 }
%
%    % Δημιουργία του πίνακα
	\cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {rows} { \l_tmpa_int }
    \prop_gput:cnn { g_csm_matrix_#1_prop } {columns} { \l_tmpa_int }
%
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
		\fparray_new:cn { g_csm_matrix_#1_fparray } { \int_eval:n { \l_tmpa_int * \l_tmpa_int } }
	}
%
%    % Γέμισμα με 0.0, εκτός της διαγωνίου (που είναι 1.0)
    \int_step_inline:nn {\int_eval:n { \l_tmpa_int * \l_tmpa_int } }
    {
        \fparray_gset:cnn { g_csm_matrix_#1_fparray } { ##1 } { 0.0 }
    }
%
%    % Θέτουμε 1.0 στη διαγώνιο
    \int_step_inline:nn { \l_tmpa_int }
    {
%        % Ο δείκτης kC για το A[i][i] σε 1-based indexing είναι (i-1)*n + i
        \int_set:Nn \l_tmpb_int { (##1 - 1) * \l_tmpa_int + ##1 }
        \fparray_gset:cnn { g_csm_matrix_#1_fparray } { \l_tmpb_int } { 1.0 }
    }
}

\NewDocumentCommand{\csmMatrixIdentity}{mm}
{
	\matrixIdentity:nn {#1}{#2}
}
