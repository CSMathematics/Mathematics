%=========================================================================
%	MATRIX MULTIPLICATION
%	#1: Product  C (m x n)
%	#2: 		 A (m x p)
%	#3			 B (q x n)    - πρέπει p=q
%=========================================================================
\cs_new_protected:Nn \matrixMultiplication:nnn
{
	\int_set:Nn \l_A_rows { \prop_item:cn { g_csm_matrix_#2_prop } {rows} } % m γραμμές
  	\int_set:Nn \l_A_columns { \prop_item:cn { g_csm_matrix_#2_prop } {columns} } % p στηλες

	\int_set:Nn \l_B_rows { \prop_item:cn { g_csm_matrix_#3_prop } {rows} } % q γραμμές
  	\int_set:Nn \l_B_columns { \prop_item:cn { g_csm_matrix_#3_prop } {columns} } % n στηλες

	\cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {rows} {\l_A_rows}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {columns} {\l_B_columns}
    \prop_gput:cne { g_csm_matrix_#1_prop } {entries} { \int_eval:n { \l_A_rows*\l_B_columns } }
    % allocate the array and store the entries
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
    	\fparray_new:cn { g_csm_matrix_#1_fparray } { \int_eval:n { \l_A_rows*\l_B_columns } }
	}

	\int_step_inline:nn {\l_A_rows} % i=1,...,m
	{
		\int_step_inline:nn {\l_B_columns} % j=1,...,n
		{
			\fp_zero:N \cij_sum
			\int_set:Nn \C_linIndex {(##1-1)*\l_B_columns+####1}
			\int_step_inline:nn {\l_A_columns} % k=1,...,p
			{
				\int_set:Nn \A_linIndex {(##1-1)*\l_A_columns+########1}
				\int_set:Nn \B_linIndex {(########1-1)*\l_B_columns+####1}
				\fp_add:Nn \cij_sum
					{
						\fp_eval:n
						{
						\fparray_item_to_tl:cn { g_csm_matrix_#2_fparray }{ \A_linIndex }*
						\fparray_item_to_tl:cn { g_csm_matrix_#3_fparray }{ \B_linIndex }
						}
					}
			}
			\fparray_gset:cnn { g_csm_matrix_#1_fparray } {\C_linIndex} {\cij_sum}
		}
	}
}

\NewDocumentCommand{\csmMatrixMultiplication}{ m m m }
{
	\matrixMultiplication:nnn {#1}{#2}{#3}
}
