\NewDocumentCommand{\csmDefinematrix}{mmmm}
 {% #1 = matrix name, #2 = rows, #3 = columns, #4 = entries
  \csm_matrix_define:nnnn {#1} {#2} {#3} {#4}
 }

\cs_new_protected:Nn \csm_matrix_define:nnnn
 {
  % check whether the number of entries is correct
  \int_compare:nTF { #2*#3 == \clist_count:n {#4} }
   {% match!
    % store the number of rows and columns
    \cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {rows} {#2}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {columns} {#3}
    \prop_gput:cne { g_csm_matrix_#1_prop } {entries} { \int_eval:n {#2*#3} }
    % allocate the array and store the entries
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
    	\fparray_new:cn { g_csm_matrix_#1_fparray } { \clist_count:n {#4} }
	}
    \int_step_inline:nn { \clist_count:n {#4} }
     {
      \fparray_gset:cnn { g_csm_matrix_#1_fparray } {##1} { \clist_item:nn {#4} {##1} }
     }
   }
   {% no match!
    \msg_error:nnx {mymatrix}{dimension-mismatch}
     {
      The~matrix~#1~of~size~#2 x #3~requires~\int_eval:n{#2*#3}~elements,~
      but~\clist_count:n{#4}~were~given.
     }
   }
 }
