%=========================================================================
\cs_new_protected:Nn \matrixCopy:nn
{
% #1 = C (Προορισμός), #2 = A (Πηγή)

    % 1. Διαγραφή παλιού πίνακα προορισμού (αν υπάρχει)
%    \prop_gremove:cn { g_csm_matrix_#1_prop } { rows }
%    \fparray_gremove:cn { g_csm_matrix_#1_fparray }

    % 2. Δημιουργία νέων δομών για τον προορισμό
    \cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}

    % 3. Αντιγραφή των ιδιοτήτων (rows, columns, entries)

    % n (Διάσταση): Χρήση l_tmpa_int για το n
    \int_set:Nn \l_tmpa_int { \prop_item:cn { g_csm_matrix_#2_prop } {rows} }

    \prop_gput:cnn { g_csm_matrix_#1_prop } {rows} { \l_tmpa_int }
    \prop_gput:cnn { g_csm_matrix_#1_prop } {columns} { \l_tmpa_int } % Υποθέτουμε τετραγωνικό

    % total_entries (n*n): Χρήση l_tmpb_int
    \int_set:Nn \l_tmpb_int { \int_eval:n { \l_tmpa_int * \l_tmpa_int } }
    \prop_gput:cnn { g_csm_matrix_#1_prop } {entries} { \l_tmpb_int }

    % 4. Δημιουργία και Αντιγραφή του Fparray
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
    	\fparray_new:cn { g_csm_matrix_#1_fparray } { \l_tmpb_int }
	}

    % 5. Βρόχος για την αντιγραφή των στοιχείων (1-based indexing)
    \int_step_inline:nn { \l_tmpb_int }
    {
        % Ανάκτηση του στοιχείου από την πηγή (#2)
        \fp_set:Nn \l_tmpa_fp { \fparray_item_to_tl:cn { g_csm_matrix_#2_fparray } { ##1 } }

        % Θέση του στοιχείου στον προορισμό (#1)
        \fparray_gset:cnn { g_csm_matrix_#1_fparray } { ##1 } {\l_tmpa_fp}
    }
%$\printmatrix{#1}$
}

\NewDocumentCommand{\csmMatrixCopy}{mm}
{
	\matrixCopy:nn{#1}{#2}
}
