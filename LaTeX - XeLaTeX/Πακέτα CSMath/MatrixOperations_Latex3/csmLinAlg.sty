%=========================================================================
%	Matrix Power
%=========================================================================
\cs_new_protected:Nn \matrixPower:nnn
{
% #1 = C (Αποτέλεσμα), #2 = A (Βάση), #3 = k (Εκθέτης)
    % 1. Αρχικοποίηση Μεταβλητών και Μεταφορά Δεδομένων
    % n (Διάσταση): Χρήση l_tmpa_int για το n
    \int_set:Nn \l_tmpa_int { \prop_item:cn { g_csm_matrix_#2_prop } {rows} }
    % k (Εκθέτης): Χρήση της l_k_int (υποθέτουμε ότι έχει δηλωθεί μία φορά)
    \int_set:Nn \l_k_int { #3 }

    % 2. Δημιουργία Προσωρινών Ονομάτων
    % Χρησιμοποιούμε l_tmpa_tl, l_tmpb_tl για τα ονόματα των βοηθητικών πινάκων
    \tl_set:Nn \l_temp_A_tl { matrix_power_base_aux }   % Base
    \tl_set:Nn \l_temp_R_tl { matrix_power_result_aux } % Result

    % 3. Αρχικοποίηση Αποτελέσματος (Result = I)
    \matrixIdentity:nn { \l_temp_R_tl } { \l_tmpa_int } % Χρήση l_tmpa_int (n)

    % Αντιγραφή της βάσης A σε έναν προσωρινό πίνακα (Base = A)
    \matrixCopy:nn { \l_temp_A_tl } { #2 }
    \tl_set:Nn \l_tmpc_tl { matrix_power_int_product_aux } % Χρήση l_tmpc_tl για το όνομα του γινομένου
    % 4. Matrix Exponentiation Loop (Όσο k > 0)
    \group_begin:
    \int_until_do:nNnn { \l_k_int } = {0}
    {
%        % 4.1. Έλεγχος για ΜΟΝΟ ΕΚΘΕΤΗ (k & 1)
        \int_compare:nNnTF { \int_mod:nn {\l_k_int}{2} } = { 1 }
        {
%            % Result = Result * Base
            \matrixMultiplication:nnn { \l_tmpc_tl } { \l_temp_R_tl } { \l_temp_A_tl }
%
%            % Αντιγράφουμε το γινόμενο πίσω στο Result: Result = temp_product
            \matrixCopy:nn { \l_temp_R_tl } { \l_tmpc_tl }

		\int_set:Nn \l_k_int { \l_k_int - 1 }

        }{
%        % 4.2. Τετραγωνισμός της Βάσης (Base = Base * Base)
        \tl_set:Nn \l_tmpc_tl { matrix_power_product_aux }
        \matrixMultiplication:nnn { \l_tmpc_tl } { \l_temp_A_tl } { \l_temp_A_tl }
%
%        % Αντιγραφή του τετραγωνισμένου πίνακα πίσω στο Base: Base = temp_product
        \matrixCopy:nn { \l_temp_A_tl } { \l_tmpc_tl }

%
%        % 4.3. Διαίρεση του k με το 2 (k >>= 1)
        \int_set:Nn \l_k_int { \l_k_int / 2 }
		}
    }
    \group_end:
% 5. Τελική Αντιγραφή
    \matrixCopy:nn { #1 } { \l_temp_R_tl }

    % 6. Καθαρισμός
    % ... (Ο καθαρισμός παραμένει σωστός) ...
}

\NewDocumentCommand{\csmMatrixPower}{mmm}
{
	\matrixPower:nnn{#1}{#2}{#3}
}

%=========================================================================
%	DETERMINANT
%=========================================================================
% Νέο μήνυμα σφάλματος
\msg_new:nnn {mymatrix}{not-square} {Matrix~'#1'~is~not~square.~Determinant~is~undefined.}

% --- Μεταβλητές εργασίας ---
\int_new:N \l_csm_matrix_n_int            % Διάσταση n του n x n πίνακα
\int_new:N \l_csm_matrix_max_row_int     % Δείκτης γραμμής για τον οδηγό
\fp_new:N \l_csm_matrix_det_fp           % Η τρέχουσα τιμή της ορίζουσας
\fp_new:N \l_csm_matrix_sign_fp          % Το πρόσημο (από τις εναλλαγές)
\fp_new:N \l_csm_matrix_max_fp           % Μέγιστος οδηγός (pivot)
\fp_new:N \l_csm_matrix_pivot_fp         % Τρέχων οδηγός
\fp_new:N \l_csm_matrix_factor_fp        % Ο πολλαπλασιαστής για την απαλοιφή

% --- Βοηθητικές Συναρτήσεις ---
% \__csm_matrix_get:Nnnn { <array> } { <n> } { <i> } { <j> }
% Επιστρέφει την τιμή A[i, j] από τον 1D fparray
% <n> = αριθμός στηλών
\cs_new:Nn \__csm_matrix_get:Nnnn
 {
  \fparray_item:Nn #1 { \int_eval:n { (#3 - 1) * #2 + #4 } }
 }

% \__csm_matrix_set:NnnnF { <array> } { <n> } { <i> } { <j> } { <value> }
% Θέτει την τιμή A[i, j] = <value> στον 1D fparray
\cs_new_protected:Nn \__csm_matrix_set:NnnnF
 {
  \fparray_gset:Nnn #1 { \int_eval:n { (#3 - 1) * #2 + #4 } } {#5}
 }

% --- Κύρια Συνάρτηση Ορίζουσας ---

% \csm_matrix_determinant:nN { <matrix_name> } { <result_tl> }
% Υπολογίζει την ορίζουσα του πίνακα <matrix_name>
% και αποθηκεύει το αποτέλεσμα (fp) στην <result_tl>
\cs_new_protected:Nn \matrix_determinant:n
 {
  % 1. Λήψη διαστάσεων και έλεγχος αν είναι τετραγωνικός
	\int_set:Nn \l_tmpa_int { \prop_item:cn { g_csm_matrix_#1_prop } {rows} }
	\int_set:Nn \l_tmpb_int { \prop_item:cn { g_csm_matrix_#1_prop } {columns} }
  \tl_new:c {l_det #1 _int}
%
  \int_compare:nNnTF {\l_tmpa_int} = {\l_tmpb_int}
   { % Είναι τετραγωνικός, αποθήκευσε τη διάσταση n
    \int_set_eq:NN \l_csm_matrix_n_int \l_tmpa_int
   }
   { % Δεν είναι τετραγωνικός
    \msg_error:nnn {mymatrix}{not-square} {#1}
    \tl_set:cn {l_det#1 _tl} {Undefined}
    \prg_return_false: % Έξοδος από τη συνάρτηση
   }
%
  % Ειδική περίπτωση: Πίνακας 1x1
  \int_compare:nNnTF {\l_csm_matrix_n_int} = {1}
    {
      \tl_set:cx {l_det#1 _tl} { \fparray_item:cn { g_csm_matrix_#1_fparray } { 1 } }
      \prg_return_true: % Έξοδος
    }
    {} % Δεν είναι 1x1, συνέχεια
%
  % 2. Δημιουργία τοπικού, "αναλώσιμου" αντιγράφου του πίνακα

	\int_set:Nn \l_tmpa_int {\l_csm_matrix_n_int*\l_csm_matrix_n_int}
	\cs_if_exist:NTF \l_csm_matrix_copy_fparray{}
  	{
  		\fparray_new:Nn \l_csm_matrix_copy_fparray { \l_csm_matrix_n_int*\l_csm_matrix_n_int }
	}

  \int_step_inline:nn { \l_tmpa_int }
   {
    \fparray_gset:Nnn \l_csm_matrix_copy_fparray {##1}
     { \fparray_item:cn { g_csm_matrix_#1_fparray } {##1} }
   }
%
%  % 3. Αρχικοποίηση ορίζουσας και προσήμου
  \fp_set:Nn \l_csm_matrix_det_fp { 1.0 }
  \fp_set:Nn \l_csm_matrix_sign_fp { 1.0 }
%
  % 4. Βρόχος Απαλοιφής Gauss (για j = 1 έως n-1)
%  \prg_block_clear_new:N \__csm_matrix_gauss_loop % Δημιουργία "break" σημείου
  \int_step_variable:nNn { \l_csm_matrix_n_int - 1 } \l_tmpa_int % \l_tmpa_int = j (στήλη οδηγός)
   {
    % 4a. Εύρεση οδηγού (μερική οδήγηση)
    % Βρες τη γραμμή i >= j με το μέγιστο |A[i, j]|
    \fp_set:Nn \l_csm_matrix_max_fp
     {
      \fp_abs:n { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpa_int \l_tmpa_int } % |A[j, j]|
     }
    \int_set:Nn \l_csm_matrix_max_row_int { \l_tmpa_int } % j

    \int_step_variable:nnNn { \l_tmpa_int + 1 } { \l_csm_matrix_n_int } \l_tmpb_int % \l_tmpb_int = i (γραμμή προς έλεγχο)
     {
      \fp_set:Nn \l_csm_matrix_pivot_fp
       {
        \fp_abs:n { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpb_int \l_tmpa_int } % |A[i, j]|
       }
      \fp_compare:nNnTF \l_csm_matrix_pivot_fp > \l_csm_matrix_max_fp
       { % Βρέθηκε νέο μέγιστο
        \fp_set_eq:NN \l_csm_matrix_max_fp \l_csm_matrix_pivot_fp
        \int_set_eq:NN \l_csm_matrix_max_row_int \l_tmpb_int % Αποθήκευση γραμμής i
       }
       {} % Όχι νέο μέγιστο
     } % τέλος βρόχου i

    % 4b. Έλεγχος για ιδιόμορφο πίνακα (singular)
    % Χρησιμοποιούμε μικρό όριο (epsilon) αντί για 0.0 για αριθμητική σταθερότητα
    \fp_compare:nNnTF \l_csm_matrix_max_fp < { 1e-18 }
     { % Ο πίνακας είναι ιδιόμορφος, ορίζουσα = 0
      \fp_set:Nn \l_csm_matrix_det_fp { 0.0 }
      \prg_block_break:N \__csm_matrix_gauss_loop % Έξοδος από τον κύριο βρόχο (j)
     }
     { % Ο πίνακας δεν είναι ιδιόμορφος, συνέχεια
%      % 4c. Εναλλαγή γραμμών (αν χρειάζεται)
      \int_compare:nNnTF {\l_csm_matrix_max_row_int} = {\l_tmpa_int} % if max_row != j
		{} % Δεν χρειάζεται εναλλαγή
		{
%         Εναλλαγή γραμμής j (l_tmpa_int) με γραμμή max_row (l_csm_matrix_max_row_int)
        \int_step_variable:nnNn { 1 } { \l_csm_matrix_n_int } \l_tmpd_int % \l_tmpd_int = l (στήλη)
         {
          % tmp = A[j, l]
          \fp_set:Nn \l_tmpa_fp { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpa_int \l_tmpd_int }
          % A[j, l] = A[max_row, l]
          \__csm_matrix_set:NnnnF \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpa_int \l_tmpd_int
           { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_csm_matrix_max_row_int \l_tmpd_int }
          % A[max_row, l] = tmp
          \__csm_matrix_set:NnnnF \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_csm_matrix_max_row_int \l_tmpd_int { \l_tmpa_fp }
         }
%        % Αλλαγή προσήμου ορίζουσας
        \fp_set:Nn \l_csm_matrix_sign_fp { -1.0 }
       }
%
      % 4d. Απαλοιφή (Μηδενισμός στοιχείων κάτω από τον οδηγό)
      \int_step_variable:nnNn { \l_tmpa_int + 1 } { \l_csm_matrix_n_int } \l_tmpc_int % \l_tmpc_int = k (γραμμή προς απαλοιφή)
       {
        % Υπολογισμός παράγοντα: factor = A[k, j] / A[j, j]
        \fp_gset:Nn \l_csm_matrix_factor_fp
         {
          \fp_eval:n {
           { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpc_int \l_tmpa_int } /
           { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpa_int \l_tmpa_int } % A[j, j]
         }
		}

        % Για αριθμητική ακρίβεια, θέτουμε ρητά το A[k, j] = 0
        \__csm_matrix_set:NnnnF \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpc_int \l_tmpa_int { 0.0 }

        % Ενημέρωση των υπόλοιπων στοιχείων της γραμμής k
        % Βρόχος για στήλες l = j+1 έως n
        \int_step_variable:nnNn { \l_tmpa_int + 1 } { \l_csm_matrix_n_int } \l_tmpd_int
         {
          % A[k, l] = A[k, l] - factor * A[j, l]

          % val = A[k, l]
          \fp_gset:Nn \l_tmpa_fp { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpc_int \l_tmpd_int }

          % sub_val = factor * A[j, l]
          \fp_gset:Nn \l_tmpb_fp
           {
            \fp_eval:n {\l_csm_matrix_factor_fp *
             { \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpa_int \l_tmpd_int }}
           }
%
          % new_val = val - sub_val
          \fp_gset:Nn \l_tmpa_fp {\fp_eval:n {\l_tmpa_fp-\l_tmpb_fp}}
%
%          % Θέσε A[k, l] = new_val
          \__csm_matrix_set:NnnnF \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpc_int \l_tmpd_int { \l_tmpa_fp }
         } % τέλος βρόχου l
       } % τέλος βρόχου k
%     } % τέλος ελέγχου if singular
   } % τέλος κύριου βρόχου j (\__csm_matrix_gauss_loop)
%
%  % 5. Υπολογισμός τελικής ορίζουσας
  \fp_compare:nNnTF \l_csm_matrix_det_fp = { 0.0 }
   { % Ιδιόμορφος πίνακας, η ορίζουσα είναι ήδη 0
    \tl_set:cn {l_det#1 _tl} { 1.0 }
   }
   { % Μη-ιδιόμορφος: Γινόμενο διαγωνίων * πρόσημο
    \fp_set_eq:NN \l_csm_matrix_det_fp \l_csm_matrix_sign_fp % Ξεκίνα με το πρόσημο
    \int_step_variable:nnNn { 1 } { \l_csm_matrix_n_int } \l_tmpa_int % i = 1 έως n
     {
%      % det = det * A[i, i]
      \fp_gset:Nn \l_csm_matrix_det_fp
		{\fp_eval:n \l_csm_matrix_det_fp*{ \__csm_matrix_get:Nnnn \l_csm_matrix_copy_fparray \l_csm_matrix_n_int \l_tmpa_int \l_tmpa_int }
		}
     }
%    % Αποθήκευση αποτελέσματος στην tl

%	\tl_use:c {l_det#1 _tl}
	}
   }
	\fp_use:N \l_csm_matrix_det_fp
 }

\NewDocumentCommand{\csmDeterminant}{m}
{
	\matrix_determinant:n {#1}
}


