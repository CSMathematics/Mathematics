%=========================================================================
%	ΑΝΑΣΤΡΟΦΟΣ ΠΙΝΑΚΑΣ
%=========================================================================
\cs_new_protected:Nn \transposeMatrix:nn
{
	\int_set:Nn \l_old_rows { \prop_item:cn { g_csm_matrix_#2_prop } {rows} }
  	\int_set:Nn \l_old_columns { \prop_item:cn { g_csm_matrix_#2_prop } {columns} }

	\cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {rows} {\l_old_columns}
    \prop_gput:cnn { g_csm_matrix_#1_prop } {columns} {\l_old_rows}
    \prop_gput:cne { g_csm_matrix_#1_prop } {entries} { \int_eval:n { \l_old_rows*\l__csm_matrix_columns_int} }
    % allocate the array and store the entries
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
    	\fparray_new:cn { g_csm_matrix_#1_fparray } { \int_eval:n { \l_old_rows*\l_old_columns} }
	}


  	\int_step_inline:nn { \l_old_columns }
   	{
		\int_step_inline:nn { \l_old_rows }
	    {
			\fparray_gset:cnn { g_csm_matrix_#1_fparray } { \int_eval:n {(##1-1)*\l_old_rows + ####1 }} { \fparray_item_to_tl:cn { g_csm_matrix_#2_fparray }
	        { \int_eval:n {(####1-1)*\l_old_columns + ##1 }} }
     	}
   	}
}

\NewDocumentCommand{\csmTransposeMatrix}{ m m }
{
	\transposeMatrix:nn {#1}{#2}
}
