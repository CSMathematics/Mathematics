\NewDocumentCommand{\csmMatrixLinComb}{mO{1}mO{1}m}
 {% #1 = linear combination
  % #2 = coefficient for the first summand
  % #3 = first summand
  % #4 = coefficient for the second summand
  % #5 = second summand
  \csm_matrix_lc:nnnnn {#1} {#2} {#3} {#4} {#5}
 }
\NewDocumentCommand{\csmMatrixSum}{mm}
 {% #1 = sum
  % #2 = list of matrices
  \csm_matrix_sum:nn {#1} {#2}
 }

\cs_new_protected:Nn \csm_matrix_lc:nnnnn
 {
  \bool_lazy_and:nnTF
   {
    \int_compare_p:nNn
     { \prop_item:cn { g_csm_matrix_#3_prop } {rows} }
     =
     { \prop_item:cn { g_csm_matrix_#5_prop } {rows} }
   }
   {
    \int_compare_p:nNn
     { \prop_item:cn { g_csm_matrix_#3_prop } {columns} }
     =
     { \prop_item:cn { g_csm_matrix_#5_prop } {columns} }
   }
   {
    \__csm_matrix_lc:nnnnn {#1} {#2} {#3} {#4} {#5}
   }
   {% mismatch
    \msg_error:nnx {mymatrix}{sum-mismatch}
     {
      The~matrix~sizes~don't~match
     }
   }
 }

\cs_new_protected:Nn \__csm_matrix_lc:nnnnn
 {
  \cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}
  \prop_gset_eq:cc { g_csm_matrix_#1_prop } { g_csm_matrix_#3_prop }
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
    	\fparray_new:cn { g_csm_matrix_#1_fparray } { \fparray_count:c { g_csm_matrix_#3_fparray}}
	}
  \int_step_inline:nn { \fparray_count:c { g_csm_matrix_#3_fparray } }
   {
    \fparray_gset:cnn { g_csm_matrix_#1_fparray } {##1}
     {
      (#2)*(\fparray_item:cn { g_csm_matrix_#3_fparray } {##1})
      +
      (#4)*(\fparray_item:cn { g_csm_matrix_#5_fparray } {##1})
     }
   }
 }

\cs_new_protected:Nn \csm_matrix_sum:nn
 {
  \cs_if_exist:cTF { g_csm_matrix_#1_prop }{}
  	{
    	\prop_new:c { g_csm_matrix_#1_prop }
	}
  \prop_gset_eq:cc { g_csm_matrix_#1_prop } { g_csm_matrix_ \clist_item:nn {#2}{1} _prop }
	\cs_if_exist:cTF { g_csm_matrix_#1_fparray }{}
  	{
    	\fparray_new:cn { g_csm_matrix_#1_fparray }
	   {
	    \prop_item:cn { g_csm_matrix_ \clist_item:nn {#2}{1} _prop } {entries}
	   }
	}

  \int_step_inline:nn { \fparray_count:c { g_csm_matrix_#1_fparray } }
   {
    \cs_set:Nn \__csm_matrix_do_sum:n
     {
      + \fparray_item:cn { g_csm_matrix_####1_fparray } {##1}
     }
    \fparray_gset:cnn { g_csm_matrix_#1_fparray } {##1}
     {
      0 \clist_map_function:nN {#2} \__csm_matrix_do_sum:n
     }
   }
 }

\NewDocumentCommand{\csmMatrixSub}{ m m m }
{
	\csmMatrixLinComb{#1}{#2}[-1]{#3}
}

