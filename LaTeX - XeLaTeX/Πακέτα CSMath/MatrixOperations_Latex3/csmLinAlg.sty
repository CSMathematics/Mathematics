%	Matrix Trace
%=========================================================================
\cs_new_protected:Nn \trace:n
{
	\int_set:Nn \l_A_rows { \prop_item:cn { g_csm_matrix_#1_prop } {rows} } % m γραμμές
  	\int_set:Nn \l_A_columns { \prop_item:cn { g_csm_matrix_#1_prop } {columns} } % p στηλες

	\int_step_inline:nn {\l_A_rows}
	{
		\fp_add:Nn \l_trace_sum {
    	\fparray_item_to_tl:cn { g_csm_matrix_#1_fparray }{\int_eval:n {(##1-1)*\l_A_rows+##1}}}
	}
	\fp_use:N \l_trace_sum
}

\NewDocumentCommand{\csmMatrixTrace}{m}
{
	\trace:n {#1}
}
